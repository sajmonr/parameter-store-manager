{
  "name": "parameter-store-manager",
  "productName": "Parameter Store Manager",
  "version": "0.7.0",
  "description": "AWS Parameter store manager application that allows easy viewing and managing of parameters.",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "package": "npm run build && electron-builder build --publish never",
    "package-all": "npm run build && electron-builder build -mwl",
    "package-linux": "npm run build && electron-builder build --linux",
    "package-win": "npm run build && electron-builder build --win --x64",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "homepage": "https://github.com/sajmonr/parameter-store-manager",
  "main": "./out/main/index.js",
  "build": {
    "appId": "org.sajmonr.ParameterStoreManager",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "sajmonr <a.simonicek@yahoo.ca>",
      "executableName": "parameter-store-manager"
    },
    "appImage": {
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "sajmonr",
      "repo": "parameter-store-manager",
      "private": false
    }
  },
  "author": {
    "name": "sajmonr"
  },
  "license": "MIT",
  "keywords": [
    "electron",
    "react",
    "redux",
    "aws",
    "parameterstore",
    "ssm",
    "parameters",
    "storage"
  ],
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.2.0",
    "antd": "^5.29.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-debug": "^5.0.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-store": "^11.0.2",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "javascript-time-ago": "^2.6.4",
    "jsdom": "^30.1.2",
    "p-all": "^5.0.1",
    "prettier": "^3.9.9",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-time-ago": "^7.4.4",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.3.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1144.0",
    "@aws-sdk/client-ssm": "^3.1144.0",
    "@aws-sdk/credential-providers": "^3.1144.0",
    "electron-log": "^5.4.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
